     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="15.893cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">My magazine </text:span><text:span text:style-name="T11">subscription expires </text:span><text:span text:style-name="T11">next month.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Twenty-second </text:span><text:span text:style-name="T11">Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">My magazine </text:span><text:span text:style-name="T11">subscription expires </text:span><text:span text:style-name="T11">next month.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Subscription</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Subscription&apos; refers </text:span><text:span text:style-name="T11">to an arrangement </text:span><text:span text:style-name="T11">where you pay </text:span><text:span text:style-name="T11">regularly to receive a </text:span><text:span text:style-name="T11">service or </text:span><text:span text:style-name="T11">publication. </text:span><text:span text:style-name="T11">Subscription shows </text:span><text:span text:style-name="T11">regular payment for </text:span><text:span text:style-name="T11">continued access. </text:span><text:span text:style-name="T11">People notice a </text:span><text:span text:style-name="T11">regular payment for </text:span><text:span text:style-name="T11">ongoing access. It is </text:span><text:span text:style-name="T11">a noun. For example, </text:span><text:span text:style-name="T11">&apos;She has a monthly </text:span><text:span text:style-name="T11">subscription to a </text:span><text:span text:style-name="T11">streaming service&apos; </text:span><text:span text:style-name="T11">means she pays </text:span><text:span text:style-name="T11">each month to </text:span><text:span text:style-name="T11">continue using it.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">구독 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">가입 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">기부금</text:span><text:span text:style-name="T12">. </text:span><text:span text:style-name="T12">Subscription. </text:span><text:span text:style-name="T12">구독 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">가입 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">기부금</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">내 잡지 구독은 다음 </text:span><text:span text:style-name="T13">달에 만료된다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">My magazine </text:span><text:span text:style-name="T11">subscription expires </text:span><text:span text:style-name="T11">next month.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">내 잡지 구독은 다음 </text:span><text:span text:style-name="T13">달에 만료된다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
