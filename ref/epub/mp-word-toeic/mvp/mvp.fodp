      <text:p xml:id="id28" text:id="id28" text:style-name="P7"><text:span text:style-name="T20">나는 다가오는 콘서트가 </text:span><text:span text:style-name="T20">기대된다</text:span><text:span text:style-name="T21">.</text:span></text:p>
