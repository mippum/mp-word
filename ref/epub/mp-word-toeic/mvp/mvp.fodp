    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="22" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="17.393cm" svg:x="2cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">She picked up a travel brochure at the airport.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Twentieth Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">She picked up a travel brochure at the airport.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Brochure</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Brochure&apos; refers to a small booklet or folded sheet containing information about a product, service, or place. Brochure shows promotional informational booklet. People notice a printed document used to share information or advertise. It is a noun. For example, &apos;She picked up a brochure about the hotel at the tourist office&apos; means a small printed booklet describing the hotel.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">소책자 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">안내 책자</text:span><text:span text:style-name="T12">. Brochure. </text:span><text:span text:style-name="T12">소책자 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">안내 책자</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">그녀는 공항에서 여행 안내 책자를 집어 들었습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">She picked up a travel brochure at the airport.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">그녀는 공항에서 여행 안내 책자를 집어 들었습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
