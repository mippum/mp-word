    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="9" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">Each applicant must submit a resume.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Seventh Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Each applicant must submit a resume.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Applicant</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Applicant&apos; refers to a person who </text:span><text:span text:style-name="T11">formally applies for something such as a </text:span><text:span text:style-name="T11">job or a place at university. Applicant </text:span><text:span text:style-name="T11">shows person making a formal request. </text:span><text:span text:style-name="T11">People notice someone seeking </text:span><text:span text:style-name="T11">something through an official process. It </text:span><text:span text:style-name="T11">is a noun. For example, &apos;All applicants </text:span><text:span text:style-name="T11">must submit their documents by Friday&apos; </text:span><text:span text:style-name="T11">means everyone formally applying must </text:span><text:span text:style-name="T11">do so by then.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">지원자 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">신청인</text:span><text:span text:style-name="T12">. Applicant. </text:span><text:span text:style-name="T12">지원자 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">신청인</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">모든 지원자는 이력서를 제출해야 한다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Each applicant must submit a resume.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">모든 지원자는 이력서를 제출해야 한다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
