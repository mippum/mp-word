     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T3">You are eligible to </text:span><text:span text:style-name="T3">vote at 18.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P37" draw:layer="layout" svg:width="4.6cm" svg:height="1.591cm" svg:x="0.9cm" svg:y="9.409cm">
