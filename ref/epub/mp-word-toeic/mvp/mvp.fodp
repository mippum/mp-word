    <draw:frame draw:style-name="gr14" draw:text-style-name="P23" draw:layer="layout" svg:width="10.5cm" svg:height="1.674cm" svg:x="0cm" svg:y="11.2cm">
     <draw:text-box>
      <text:p xml:id="id6" text:id="id6" text:style-name="P7"><text:span text:style-name="T7">진심으로 </text:span><text:span text:style-name="T7">/ </text:span><text:span text:style-name="T7">성실하게</text:span><text:span text:style-name="T7"><text:line-break/></text:span><text:span text:style-name="T8">(</text:span><text:span text:style-name="T9">편지 끝맺음 표현으로도 사용</text:span><text:span text:style-name="T8">)</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P8" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="5.4cm">
