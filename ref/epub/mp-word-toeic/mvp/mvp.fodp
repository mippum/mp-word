    <presentation:notes draw:style-name="dp2">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="3" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">I sincerely apologize </text:span><text:span text:style-name="T11">for the mistake.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">First Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">I sincerely apologize </text:span><text:span text:style-name="T11">for the mistake.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Sincerely</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Sincerely&apos; means in a </text:span><text:span text:style-name="T11">genuine and honest </text:span><text:span text:style-name="T11">way, without </text:span><text:span text:style-name="T11">pretending. Sincerely </text:span><text:span text:style-name="T11">shows genuine feeling </text:span><text:span text:style-name="T11">or expression. People </text:span><text:span text:style-name="T11">notice a true and </text:span><text:span text:style-name="T11">heartfelt manner. It is </text:span><text:span text:style-name="T11">an adverb. For </text:span><text:span text:style-name="T11">example, &apos;I sincerely </text:span><text:span text:style-name="T11">hope you feel better </text:span><text:span text:style-name="T11">soon&apos; means I truly </text:span><text:span text:style-name="T11">and genuinely hope </text:span><text:span text:style-name="T11">so. It is also commonly </text:span><text:span text:style-name="T11">used at the end of </text:span><text:span text:style-name="T11">formal letters before </text:span><text:span text:style-name="T11">signing your name.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">진심으로</text:span><text:span text:style-name="T12">, </text:span><text:span text:style-name="T12">성실하게</text:span><text:span text:style-name="T12">. </text:span><text:span text:style-name="T12">Sincerely. </text:span><text:span text:style-name="T12">진심으로</text:span><text:span text:style-name="T12">, </text:span><text:span text:style-name="T12">성실하게</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">실수에 대해 진심으로 </text:span><text:span text:style-name="T13">사과드립니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">I sincerely apologize </text:span><text:span text:style-name="T11">for the mistake.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">실수에 대해 진심으로 </text:span><text:span text:style-name="T13">사과드립니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page4" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:custom-shape draw:style-name="gr7" draw:text-style-name="P14" xml:id="id8" draw:id="id8" draw:layer="layout" svg:width="8.6cm" svg:height="6.166cm" svg:x="0.9cm" svg:y="7.5cm">
     <text:p/>
