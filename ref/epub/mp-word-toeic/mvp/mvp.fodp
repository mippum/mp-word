    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="21" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="15.893cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">The flight </text:span><text:span text:style-name="T11">attendant </text:span><text:span text:style-name="T11">smiled kindly.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Nineteenth </text:span><text:span text:style-name="T11">Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">The flight </text:span><text:span text:style-name="T11">attendant </text:span><text:span text:style-name="T11">smiled kindly.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Attendant</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Attendant&apos; </text:span><text:span text:style-name="T11">refers to a </text:span><text:span text:style-name="T11">person who </text:span><text:span text:style-name="T11">assists or </text:span><text:span text:style-name="T11">serves others </text:span><text:span text:style-name="T11">in a specific </text:span><text:span text:style-name="T11">place. </text:span><text:span text:style-name="T11">Attendant </text:span><text:span text:style-name="T11">shows serving </text:span><text:span text:style-name="T11">person. </text:span><text:span text:style-name="T11">People notice </text:span><text:span text:style-name="T11">someone </text:span><text:span text:style-name="T11">whose job is </text:span><text:span text:style-name="T11">to help. It is a </text:span><text:span text:style-name="T11">noun. For </text:span><text:span text:style-name="T11">example, &apos;The </text:span><text:span text:style-name="T11">flight </text:span><text:span text:style-name="T11">attendant </text:span><text:span text:style-name="T11">served drinks&apos; </text:span><text:span text:style-name="T11">means the </text:span><text:span text:style-name="T11">person whose </text:span><text:span text:style-name="T11">job is to help </text:span><text:span text:style-name="T11">passengers on </text:span><text:span text:style-name="T11">the plane.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">종업원 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">승무원</text:span><text:span text:style-name="T12">. </text:span><text:span text:style-name="T12">Attendant. </text:span><text:span text:style-name="T12">종업원 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">승무원</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">승무원이 </text:span><text:span text:style-name="T13">친절하게 미소 </text:span><text:span text:style-name="T13">지었어요</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">The flight </text:span><text:span text:style-name="T11">attendant </text:span><text:span text:style-name="T11">smiled kindly.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">승무원이 </text:span><text:span text:style-name="T13">친절하게 미소 </text:span><text:span text:style-name="T13">지었어요</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
