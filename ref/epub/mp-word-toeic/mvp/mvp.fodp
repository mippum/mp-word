    <draw:frame draw:style-name="gr14" draw:text-style-name="P23" draw:layer="layout" svg:width="10.5cm" svg:height="1.674cm" svg:x="0cm" svg:y="11.8cm">
     <draw:text-box>
      <text:p xml:id="id76" text:id="id76" text:style-name="P29"><text:span text:style-name="T15">품질보증서 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">보장</text:span></text:p>
