     <draw:text-box>
      <text:p xml:id="id34" text:id="id34" text:style-name="P29"><text:span text:style-name="T15">그에 따라 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">따라서</text:span></text:p>
