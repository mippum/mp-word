    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="16" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">The shipment </text:span><text:span text:style-name="T11">arrived on time.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Fourteenth </text:span><text:span text:style-name="T11">Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">The shipment </text:span><text:span text:style-name="T11">arrived on time.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Shipment</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Shipment&apos; refers to </text:span><text:span text:style-name="T11">a quantity of goods </text:span><text:span text:style-name="T11">transported </text:span><text:span text:style-name="T11">together. Shipment </text:span><text:span text:style-name="T11">shows transported </text:span><text:span text:style-name="T11">goods. People notice </text:span><text:span text:style-name="T11">a batch of items </text:span><text:span text:style-name="T11">being moved. It is a </text:span><text:span text:style-name="T11">noun. For example, </text:span><text:span text:style-name="T11">&apos;The shipment </text:span><text:span text:style-name="T11">arrived at the </text:span><text:span text:style-name="T11">warehouse on </text:span><text:span text:style-name="T11">Tuesday&apos; means the </text:span><text:span text:style-name="T11">batch of goods was </text:span><text:span text:style-name="T11">delivered that day.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">배송 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">선적물</text:span><text:span text:style-name="T12">. </text:span><text:span text:style-name="T12">Shipment. </text:span><text:span text:style-name="T12">배송 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">선적물</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">배송물이 제때 </text:span><text:span text:style-name="T13">도착했습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">The shipment </text:span><text:span text:style-name="T11">arrived on time.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">배송물이 제때 </text:span><text:span text:style-name="T13">도착했습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
