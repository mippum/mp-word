    <draw:frame draw:style-name="gr14" draw:text-style-name="P23" draw:layer="layout" svg:width="10.5cm" svg:height="1.674cm" svg:x="0cm" svg:y="11.7cm">
     <draw:text-box>
      <text:p xml:id="id20" text:id="id20" text:style-name="P29"><text:span text:style-name="T15">알리다 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">통지하다</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P8" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="5.7cm">
     <draw:text-box>
      <text:p xml:id="id21" text:id="id21" text:style-name="P30"><text:span text:style-name="T16">일정이 변경되면 알려주세요</text:span><text:span text:style-name="T17">.</text:span></text:p>
