    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="6" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">I’m excited about the upcoming concert.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Fourth Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">I’m excited about the upcoming concert.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Upcoming</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Upcoming&apos; means about to happen or arrive soon. Upcoming shows near future event. People notice something that has not happened yet but will soon. It is an adjective. For example, &apos;She is preparing for the upcoming exam&apos; means the one that will take place soon.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">다가오는 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">곧 있을</text:span><text:span text:style-name="T12">. Upcoming. </text:span><text:span text:style-name="T12">다가오는 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">곧 있을</text:span><text:span text:style-name="T12">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">나는 다가오는 콘서트가 기대된다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">I’m excited about the upcoming concert.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">나는 다가오는 콘서트가 기대된다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
