    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="19" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">I have a reservation at the hotel.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Seventeenth Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">I have a reservation at the hotel.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Reservation</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Reservation&apos; refers to an arrangement to have something kept for your use at a future time, such as a table at a restaurant or a hotel room. Reservation shows advance booking. People notice something set aside for them in advance. It is a noun. For example, &apos;She made a reservation at the restaurant for seven o&apos;clock&apos; means she arranged in advance to have a table available at that time.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">예약 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">보호구역 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">의구심</text:span><text:span text:style-name="T12">. Reservation. </text:span><text:span text:style-name="T12">예약 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">보호구역 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">의구심</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">호텔 예약을 마쳤습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">I have a reservation at the hotel.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">호텔 예약을 마쳤습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
