    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="23" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="15.893cm" svg:x="2cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">The store sells new merchandise every </text:span><text:span text:style-name="T11">week.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Twenty-first Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">The store sells new merchandise every </text:span><text:span text:style-name="T11">week.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Merchandise</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Merchandise&apos; refers to goods that are </text:span><text:span text:style-name="T11">bought and sold. Merchandise shows </text:span><text:span text:style-name="T11">tradeable goods. People notice products </text:span><text:span text:style-name="T11">available for purchase. It is a noun. For </text:span><text:span text:style-name="T11">example, &apos;The store had a wide range of </text:span><text:span text:style-name="T11">merchandise on display&apos; means many </text:span><text:span text:style-name="T11">different types of goods available to buy.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">상품 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">물품</text:span><text:span text:style-name="T12">. Merchandise. </text:span><text:span text:style-name="T12">상품 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">물품</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">그 가게는 매주 새로운 상품을 판매합니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">The store sells new merchandise every </text:span><text:span text:style-name="T11">week.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">그 가게는 매주 새로운 상품을 판매합니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
