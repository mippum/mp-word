    <draw:frame draw:style-name="gr15" draw:text-style-name="P8" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="6.1cm">
     <draw:text-box>
      <text:p xml:id="id133" text:id="id133" text:style-name="P30"><text:span text:style-name="T16">승무원이 친절하게 미소 지었어요</text:span><text:span text:style-name="T17">.</text:span></text:p>
