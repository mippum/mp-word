     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.4cm" svg:height="16.307cm" svg:x="2.1cm" svg:y="13.393cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">Please notify me if the schedule </text:span><text:span text:style-name="T11">changes.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Third Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Please notify me if the schedule </text:span><text:span text:style-name="T11">changes.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Notify</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Notify&apos; means to officially inform </text:span><text:span text:style-name="T11">someone about something. Notify </text:span><text:span text:style-name="T11">shows official informing. People </text:span><text:span text:style-name="T11">notice being told something </text:span><text:span text:style-name="T11">important in a formal way. It is a verb. </text:span><text:span text:style-name="T11">For example, &apos;Please notify us if your </text:span><text:span text:style-name="T11">address changes&apos; means officially </text:span><text:span text:style-name="T11">inform us of the change so we have </text:span><text:span text:style-name="T11">the correct information.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">둘러싸다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">동봉하다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">포함하다</text:span><text:span text:style-name="T12">. Notify. </text:span><text:span text:style-name="T12">알리다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">통지하다</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">일정이 변경되면 알려주세요</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Please notify me if the schedule </text:span><text:span text:style-name="T11">changes.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">일정이 변경되면 알려주세요</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
