    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="10" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">You are eligible to vote at 18.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Eighth Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">You are eligible to vote at 18.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Eligible</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Eligible&apos; means meeting the necessary requirements to qualify for something. Eligible shows meeting the conditions required. People notice whether someone is allowed or qualified. It is an adjective. For example, &apos;You are eligible to apply if you have two years of experience&apos; means you meet the requirements to do so.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">자격이 있는</text:span><text:span text:style-name="T12">. Eligible. </text:span><text:span text:style-name="T12">자격이 있는</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">18</text:span><text:span text:style-name="T13">세부터 투표할 수 있습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">I sincerely apologize for the mistake.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">18</text:span><text:span text:style-name="T13">세부터 투표할 수 있습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page11" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:custom-shape draw:style-name="gr7" draw:text-style-name="P14" xml:id="id57" draw:id="id57" draw:layer="layout" svg:width="8.6cm" svg:height="6.166cm" svg:x="0.9cm" svg:y="7.5cm">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:path-stretchpoint-x="10800" draw:path-stretchpoint-y="10800" draw:text-areas="?f3 ?f4 ?f5 ?f6" draw:type="round-rectangle" draw:modifiers="3600" draw:enhanced-path="M ?f7 0 X 0 ?f8 L 0 ?f9 Y ?f7 21600 L ?f10 21600 X 21600 ?f9 L 21600 ?f8 Y ?f10 0 Z N">
      <draw:equation draw:name="f0" draw:formula="45"/>
      <draw:equation draw:name="f1" draw:formula="$0 *sin(?f0 *(pi/180))"/>
      <draw:equation draw:name="f2" draw:formula="?f1 *3163/7636"/>
      <draw:equation draw:name="f3" draw:formula="left+?f2 "/>
      <draw:equation draw:name="f4" draw:formula="top+?f2 "/>
