     <draw:text-box>
      <text:p xml:id="id27" text:id="id27" text:style-name="P29"><text:span text:style-name="T15">다가오는 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">곧 </text:span><text:span text:style-name="T15">있을</text:span></text:p>
