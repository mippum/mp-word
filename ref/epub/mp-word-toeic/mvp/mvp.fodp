    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="18" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="15.893cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">I made an itinerary for the trip.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Sixteenth Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">I made an itinerary for the trip.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Itinerary</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Itinerary&apos; refers to a detailed plan or schedule of a journey, listing places to visit and times. Itinerary shows travel plan schedule. People notice an organized list of travel activities. It is a noun. For example, &apos;The travel agent provided a full itinerary for the trip&apos; means a document listing every stop and activity during the journey.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">여행 일정표 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">여정</text:span><text:span text:style-name="T12">. Itinerary. </text:span><text:span text:style-name="T12">여행 일정표 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">여정</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">여행 일정을 짰습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">I made an itinerary for the trip.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">여행 일정을 짰습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
