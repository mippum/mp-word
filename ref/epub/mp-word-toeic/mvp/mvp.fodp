     <draw:text-box>
      <text:p text:style-name="P7"><text:span text:style-name="T1">쭉 보시고</text:span><text:span text:style-name="T1">, </text:span><text:span text:style-name="T1">아래 링크로 테스트도 해보세요</text:span></text:p>
