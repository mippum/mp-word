    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="4" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="16.893cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P31"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p><text:span text:style-name="T11">I enclose the </text:span><text:span text:style-name="T11">document in the </text:span><text:span text:style-name="T11">letter.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Second Sentence. </text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">I enclose the </text:span><text:span text:style-name="T11">document in the </text:span><text:span text:style-name="T11">letter.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Enclose</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Enclose&apos; means to </text:span><text:span text:style-name="T11">include something </text:span><text:span text:style-name="T11">inside a letter or </text:span><text:span text:style-name="T11">package, or to </text:span><text:span text:style-name="T11">surround something </text:span><text:span text:style-name="T11">with a barrier. </text:span><text:span text:style-name="T11">Enclose shows </text:span><text:span text:style-name="T11">including inside or </text:span><text:span text:style-name="T11">surrounding. People </text:span><text:span text:style-name="T11">notice something </text:span><text:span text:style-name="T11">included with a </text:span><text:span text:style-name="T11">document or a </text:span><text:span text:style-name="T11">surrounded area. It </text:span><text:span text:style-name="T11">is a verb. For </text:span><text:span text:style-name="T11">example, &apos;Please </text:span><text:span text:style-name="T11">find the document </text:span><text:span text:style-name="T11">enclosed with this </text:span><text:span text:style-name="T11">letter&apos; means </text:span><text:span text:style-name="T11">included inside the </text:span><text:span text:style-name="T11">envelope along with </text:span><text:span text:style-name="T11">the letter.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">둘러싸다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">동봉하다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">포함하다 </text:span><text:span text:style-name="T12">Enclose. </text:span><text:span text:style-name="T12">둘러싸다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">동봉하다 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">포함하다</text:span><text:span text:style-name="T12">.</text:span><text:span text:style-name="T11"> </text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">편지에 서류를 </text:span><text:span text:style-name="T13">동봉했습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">I sincerely apologize </text:span><text:span text:style-name="T11">for the mistake.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">편지에 서류를 </text:span><text:span text:style-name="T13">동봉했습니다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page5" draw:style-name="dp3" draw:master-page-name="기본값">
