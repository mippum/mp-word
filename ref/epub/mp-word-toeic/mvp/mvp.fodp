    <draw:frame draw:style-name="gr15" draw:text-style-name="P35" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="5.5cm">
     <draw:text-box>
      <text:p xml:id="id35" text:id="id35" text:style-name="P7"><text:span text:style-name="T20">우리는 그에 따라 계획을 변경했다</text:span><text:span text:style-name="T21">.</text:span></text:p>
