    <draw:frame draw:style-name="gr14" draw:text-style-name="P23" draw:layer="layout" svg:width="10.5cm" svg:height="1.674cm" svg:x="0cm" svg:y="11.7cm">
     <draw:text-box>
      <text:p xml:id="id132" text:id="id132" text:style-name="P29"><text:span text:style-name="T15">종업원 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">승무원</text:span></text:p>
     </draw:text-box>
