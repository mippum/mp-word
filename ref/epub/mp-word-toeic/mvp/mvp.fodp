    <draw:frame draw:style-name="gr15" draw:text-style-name="P8" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="5.5cm">
     <draw:text-box>
      <text:p xml:id="id77" text:id="id77" text:style-name="P30"><text:span text:style-name="T16">이 휴대폰은 보증 기간이 남아 있습니다</text:span><text:span text:style-name="T17">.</text:span></text:p>
