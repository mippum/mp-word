    <draw:frame draw:style-name="gr14" draw:text-style-name="P23" draw:layer="layout" svg:width="10.5cm" svg:height="1.674cm" svg:x="0cm" svg:y="11.7cm">
     <draw:text-box>
      <text:p xml:id="id139" text:id="id139" text:style-name="P29"><text:span text:style-name="T15">소책자 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">안내 책자</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P8" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="5.5cm">
     <draw:text-box>
      <text:p xml:id="id140" text:id="id140" text:style-name="P30"><text:span text:style-name="T16">그녀는 공항에서 여행 안내 책자를 집어 들었습니다</text:span><text:span text:style-name="T17">.</text:span></text:p>
