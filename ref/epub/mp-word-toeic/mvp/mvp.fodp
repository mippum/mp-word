      <text:p xml:id="id7" text:id="id7" text:style-name="P7"><text:span text:style-name="T1">실수에 대해 진심으로 사과드립니다</text:span><text:span text:style-name="T1">.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
