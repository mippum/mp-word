    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="7" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P13" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:user-transformed="true">
      <draw:text-box>
       <text:p text:style-name="P26"><text:span text:style-name="T11">[</text:span><text:span text:style-name="T11">나레이션</text:span><text:span text:style-name="T11">]</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">We changed our plan accordingly.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">Fifth Sentence.</text:span><text:span text:style-name="T11"><text:line-break/></text:span><text:span text:style-name="T11">We changed our plan accordingly.</text:span></text:p>
       <text:p text:style-name="P27"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Keyword</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">Accordingly</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">&apos;Accordingly&apos; means in a way that is appropriate to the situation, or as a result. Accordingly shows appropriate action or logical consequence. People notice a response that fits the situation. It is an adverb. For example, &apos;The rules have changed, so please act accordingly&apos; means change your behavior to match the new rules.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T12">그에 따라 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">따라서 <text:s/></text:span><text:span text:style-name="T12">Accordingly. </text:span><text:span text:style-name="T12">그에 따라 </text:span><text:span text:style-name="T12">/ </text:span><text:span text:style-name="T12">따라서</text:span><text:span text:style-name="T12">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">(click)</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">우리는 그에 따라 계획을 변경했다</text:span><text:span text:style-name="T13">.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T11">We changed our plan accordingly.</text:span></text:p>
       <text:p text:style-name="P28"><text:span text:style-name="T13">우리는 그에 따라 계획을 변경했다</text:span><text:span text:style-name="T13">.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
