    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P23" draw:layer="layout" svg:width="10.5cm" svg:height="1.674cm" svg:x="0cm" svg:y="11.7cm">
     <draw:text-box>
      <text:p xml:id="id104" text:id="id104" text:style-name="P29"><text:span text:style-name="T15">영수증 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">수령 </text:span><text:span text:style-name="T15">/ </text:span><text:span text:style-name="T15">받음</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P8" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="5.8cm">
     <draw:text-box>
      <text:p xml:id="id105" text:id="id105" text:style-name="P30"><text:span text:style-name="T16">영수증을 받는 것을 잊지 마세요</text:span><text:span text:style-name="T17">.</text:span></text:p>
