   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="129" draw:name="투명도를 가진 그림 18" draw:style-name="gr3" draw:text-style-name="P11" svg:width="3.612cm" svg:height="0.28200000000000003cm" svg:x="2.194cm" svg:y="0.199cm">
