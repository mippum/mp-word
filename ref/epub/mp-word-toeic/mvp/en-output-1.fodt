   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="125" draw:name="투명도를 가진 그림 17" draw:style-name="gr3" draw:text-style-name="P11" svg:width="4.764cm" svg:height="0.28200000000000003cm" svg:x="1.6179999999999999cm" svg:y="0.199cm">
