   <text:p text:style-name="P59"><draw:line text:anchor-type="paragraph" draw:z-index="119" draw:name="가로선 64" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
