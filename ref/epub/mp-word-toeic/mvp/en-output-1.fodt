   <text:p text:style-name="P35"/>
   <text:p text:style-name="P48">S<text:span text:style-name="T9">. </text:span>U<text:span text:style-name="T9">. </text:span>P<text:span text:style-name="T9">. <text:s text:c="4"/></text:span>E<text:span text:style-name="T9">. </text:span>R<text:span text:style-name="T9">. </text:span>V<text:span text:style-name="T9">. <text:s text:c="3"/></text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>S<text:span text:style-name="T9">. </text:span>O<text:span text:style-name="T9">. </text:span>R<text:span text:style-name="T9">. </text:span><text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P49"><draw:frame text:anchor-type="paragraph" draw:z-index="413" draw:name="투명도를 가진 그림 6" draw:style-name="gr3" draw:text-style-name="P11" svg:width="5.2860000000000005cm" svg:height="0.28200000000000003cm" svg:x="1.3569999999999998cm" svg:y="0.199cm">
     <draw:image draw:mime-type="image/png">
      <office:binary-data></office:binary-data>
      <text:p/>
     </draw:image>
    </draw:frame>supervisor</text:p>
   <text:p text:style-name="P50"><draw:line text:anchor-type="paragraph" draw:z-index="412" draw:name="가로선 24" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line></text:p>
   <text:p text:style-name="P51">(영영사전 뜻)</text:p>
   <text:p text:style-name="P52">'Supervisor' refers to a person who watches over and directs the work of others. Supervisor shows person in charge of others. People notice someone managing a team or workers. It is a noun. For example, 'She reported the problem to her supervisor' means the person responsible for overseeing her work.</text:p>
   <text:p text:style-name="P53"><draw:line text:anchor-type="paragraph" draw:z-index="80" draw:name="가로선 23" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line>감독관 / 관리자 / 지도교수</text:p>
   <text:p text:style-name="P54">supervisor</text:p>
   <text:p text:style-name="P55">감독관 / 관리자 / 지도교수</text:p>
   <text:p text:style-name="P56"><draw:line text:anchor-type="paragraph" draw:z-index="81" draw:name="가로선 25" draw:style-name="gr5" draw:text-style-name="P31" svg:x1="0.847cm" svg:y1="0.237cm" svg:x2="7.155cm" svg:y2="0.237cm">
     <text:p/>
    </draw:line>감독관은 보고서를 승인했다.</text:p>
   <text:p text:style-name="P57">The supervisor approved the report.</text:p>
   <text:p text:style-name="P58">감독관은 보고서를 승인했다.</text:p>
   <text:p text:style-name="P34">Each applicant must submit a résumé.</text:p>
