   <text:p text:style-name="P21">S<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>N<text:span text:style-name="T9">. </text:span>C<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span>R<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span>L<text:span text:style-name="T9">. </text:span>Y<text:span text:style-name="T9">. <text:s text:c="4"/></text:span></text:p>
   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="73" draw:name="투명도를 가진 그림 1" draw:style-name="gr3" draw:text-style-name="P11" svg:width="3.93cm" svg:height="0.258cm" svg:x="2.035cm" svg:y="0.199cm">
     <draw:image draw:mime-type="image/png">
      <office:binary-data></office:binary-data>
      <text:p/>
     </draw:image>
    </draw:frame>sincerely</text:p>
   <text:p text:style-name="P23"><draw:line text:anchor-type="paragraph" draw:z-index="2" draw:name="가로선 4" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line></text:p>
   <text:p text:style-name="P25"><text:span text:style-name="T5">(영영사전 뜻</text:span><text:span text:style-name="T6">)</text:span></text:p>
   <text:p text:style-name="P26">'Sincerely' means in a genuine and honest way, without pretending. Sincerely shows genuine feeling or expression. People notice a true and heartfelt manner. It is an adverb. For example, 'I sincerely hope you feel better soon' means I truly and genuinely hope so. It is also commonly used at the end of formal letters before signing your name.</text:p>
   <text:p text:style-name="P27"><draw:line text:anchor-type="paragraph" draw:z-index="1" draw:name="가로선 3" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line>진심으로 / 성실하게 (편지 끝맺음 표현으로도 사용)</text:p>
   <text:p text:style-name="P28">sincerely</text:p>
   <text:p text:style-name="P29">진심으로 / 성실하게 (편지 끝맺음 표현으로도 사용)</text:p>
   <text:p text:style-name="P30"><draw:line text:anchor-type="paragraph" draw:z-index="3" draw:name="가로선 5" draw:style-name="gr5" draw:text-style-name="P31" svg:x1="0.847cm" svg:y1="0.237cm" svg:x2="7.155cm" svg:y2="0.237cm">
     <text:p/>
    </draw:line>실수에 대해 진심으로 사과드립니다.</text:p>
   <text:p text:style-name="P32">I sincerely apologize for the mistake.</text:p>
   <text:p text:style-name="P33">실수에 대해 진심으로 사과드립니다.</text:p>
   <text:p text:style-name="P34">I enclose the document in the letter.</text:p>
   <text:p text:style-name="P10"><draw:line text:anchor-type="paragraph" draw:z-index="4" draw:name="가로선 6" draw:style-name="gr1" draw:text-style-name="P11" svg:x1="4.035cm" svg:y1="0.251cm" svg:x2="5.174cm" svg:y2="0.251cm">
     <text:p/>
    </draw:line><text:span text:style-name="T7">Second</text:span> Sentence<text:span text:style-name="T1">.</text:span></text:p>
   <text:p text:style-name="P12"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P35">I enclose the document in the letter.<text:span text:style-name="T8"/></text:p>
   <text:p text:style-name="P36"/>
   <text:p text:style-name="P36"/>
   <text:p text:style-name="P36"><draw:custom-shape text:anchor-type="paragraph" draw:z-index="338" draw:name="도형 3" draw:style-name="gr2" draw:text-style-name="P19" svg:width="6.878cm" svg:height="4.128cm" svg:x="0.522cm" svg:y="0.395cm">
