   <text:p text:style-name="P21">A<text:span text:style-name="T9">. </text:span>P<text:span text:style-name="T9">. <text:s text:c="4"/></text:span>P<text:span text:style-name="T9">. <text:s text:c="4"/></text:span>L<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>C<text:span text:style-name="T9">. </text:span>A<text:span text:style-name="T9">. </text:span>N<text:span text:style-name="T9">. </text:span>T<text:span text:style-name="T9">. <text:s text:c="8"/></text:span></text:p>
