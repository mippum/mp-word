   <text:p text:style-name="P21">R<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span>C<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>P<text:span text:style-name="T9">. <text:s text:c="4"/></text:span>T<text:span text:style-name="T9">. <text:s text:c="8"/></text:span></text:p>
   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="117" draw:name="투명도를 가진 그림 15" draw:style-name="gr3" draw:text-style-name="P11" svg:width="3.306cm" svg:height="0.258cm" svg:x="2.347cm" svg:y="0.199cm">
