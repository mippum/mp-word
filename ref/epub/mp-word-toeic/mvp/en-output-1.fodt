   <text:p text:style-name="P21">E<text:span text:style-name="T9">. </text:span>L<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>G<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>B<text:span text:style-name="T9">. </text:span>L<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="89" draw:name="투명도를 가진 그림 8" draw:style-name="gr3" draw:text-style-name="P11" svg:width="4.188cm" svg:height="0.28200000000000003cm" svg:x="1.9060000000000001cm" svg:y="0.199cm">
