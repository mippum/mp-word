   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="105" draw:name="투명도를 가진 그림 12" draw:style-name="gr3" draw:text-style-name="P11" svg:width="3.924cm" svg:height="0.258cm" svg:x="2.0380000000000003cm" svg:y="0.199cm">
