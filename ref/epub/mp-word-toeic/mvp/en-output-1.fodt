   <text:p text:style-name="P21">R<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span>N<text:span text:style-name="T9">. </text:span>O<text:span text:style-name="T9">. </text:span>V<text:span text:style-name="T9">. <text:s text:c="3"/></text:span>A<text:span text:style-name="T9">. </text:span>T<text:span text:style-name="T9">. <text:s text:c="8"/></text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>O<text:span text:style-name="T9">. </text:span>N<text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="149" draw:name="투명도를 가진 그림 23" draw:style-name="gr3" draw:text-style-name="P11" svg:width="5.016cm" svg:height="0.28200000000000003cm" svg:x="1.492cm" svg:y="0.199cm">
