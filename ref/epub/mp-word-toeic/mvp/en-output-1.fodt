   <text:p text:style-name="P48">N<text:span text:style-name="T9">. </text:span>O<text:span text:style-name="T9">. </text:span>T<text:span text:style-name="T9">. <text:s text:c="8"/></text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>F<text:span text:style-name="T9">. <text:s text:c="4"/></text:span>Y<text:span text:style-name="T9">. <text:s text:c="4"/></text:span><text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P49"><draw:frame text:anchor-type="paragraph" draw:z-index="407" draw:name="투명도를 가진 그림 3" draw:style-name="gr3" draw:text-style-name="P11" svg:width="4.248cm" svg:height="0.27cm" svg:x="1.876cm" svg:y="0.199cm">
     <draw:image draw:mime-type="image/png">
      <office:binary-data></office:binary-data>
      <text:p/>
     </draw:image>
    </draw:frame>notify</text:p>
   <text:p text:style-name="P50"><draw:line text:anchor-type="paragraph" draw:z-index="406" draw:name="가로선 12" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line></text:p>
   <text:p text:style-name="P51">(영영사전 뜻)</text:p>
   <text:p text:style-name="P52">'Notify' means to officially inform someone about something. Notify shows official informing. People notice being told something important in a formal way. It is a verb. For example, 'Please notify us if your address changes' means officially inform us of the change so we have the correct information.</text:p>
   <text:p text:style-name="P53"><draw:line text:anchor-type="paragraph" draw:z-index="74" draw:name="가로선 11" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line>알리다 / 통지하다</text:p>
   <text:p text:style-name="P54">notify</text:p>
   <text:p text:style-name="P55">알리다 / 통지하다</text:p>
   <text:p text:style-name="P56"><draw:line text:anchor-type="paragraph" draw:z-index="75" draw:name="가로선 13" draw:style-name="gr5" draw:text-style-name="P31" svg:x1="0.847cm" svg:y1="0.237cm" svg:x2="7.155cm" svg:y2="0.237cm">
     <text:p/>
    </draw:line>일정이 변경되면 알려주세요.</text:p>
   <text:p text:style-name="P57">Please notify me if the schedule changes.</text:p>
   <text:p text:style-name="P58">일정이 변경되면 알려주세요.</text:p>
   <text:p text:style-name="P34">I’m excited about the upcoming concert.</text:p>
