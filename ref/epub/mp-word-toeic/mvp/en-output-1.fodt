   <text:p text:style-name="P21">M<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span>R<text:span text:style-name="T9">. </text:span>C<text:span text:style-name="T9">. </text:span>H<text:span text:style-name="T9">. </text:span>A<text:span text:style-name="T9">. </text:span>N<text:span text:style-name="T9">. </text:span>D<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>S<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="141" draw:name="투명도를 가진 그림 21" draw:style-name="gr3" draw:text-style-name="P11" svg:width="5.3580000000000005cm" svg:height="0.28200000000000003cm" svg:x="1.3209999999999997cm" svg:y="0.199cm">
