   <text:p text:style-name="P21">S<text:span text:style-name="T9">. </text:span>U<text:span text:style-name="T9">. </text:span>B<text:span text:style-name="T9">. </text:span>S<text:span text:style-name="T9">. </text:span>C<text:span text:style-name="T9">. </text:span>R<text:span text:style-name="T9">. </text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>P<text:span text:style-name="T9">. <text:s text:c="4"/></text:span>T<text:span text:style-name="T9">. <text:s text:c="8"/></text:span>I<text:span text:style-name="T9">. <text:s text:c="1"/></text:span>O<text:span text:style-name="T9">. </text:span>N<text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P22"><draw:frame text:anchor-type="paragraph" draw:z-index="145" draw:name="투명도를 가진 그림 22" draw:style-name="gr3" draw:text-style-name="P11" svg:width="5.406cm" svg:height="0.28800000000000003cm" svg:x="1.2970000000000002cm" svg:y="0.199cm">
