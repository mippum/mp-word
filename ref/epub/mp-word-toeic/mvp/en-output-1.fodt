   <text:p text:style-name="P37">E<text:span text:style-name="T9">. </text:span>N<text:span text:style-name="T9">. </text:span>C<text:span text:style-name="T9">. </text:span>L<text:span text:style-name="T9">. </text:span>O<text:span text:style-name="T9">. </text:span>S<text:span text:style-name="T9">. </text:span>E<text:span text:style-name="T9">. </text:span></text:p>
   <text:p text:style-name="P38"><draw:frame text:anchor-type="paragraph" draw:z-index="337" draw:name="투명도를 가진 그림 2" draw:style-name="gr3" draw:text-style-name="P11" svg:width="4.032cm" svg:height="0.258cm" svg:x="1.984cm" svg:y="0.199cm">
     <draw:image draw:mime-type="image/png">
      <office:binary-data></office:binary-data>
      <text:p/>
     </draw:image>
    </draw:frame>enclose</text:p>
   <text:p text:style-name="P39"><draw:line text:anchor-type="paragraph" draw:z-index="335" draw:name="가로선 8" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line></text:p>
   <text:p text:style-name="P40"><text:span text:style-name="T5">(영영사전 뜻</text:span><text:span text:style-name="T6">)</text:span></text:p>
   <text:p text:style-name="P41">'Enclose' means to include something inside a letter or package, or to surround something with a barrier. Enclose shows including inside or surrounding. People notice something included with a document or a surrounded area. It is a verb. For example, 'Please find the document enclosed with this letter' means included inside the envelope along with the letter.</text:p>
   <text:p text:style-name="P42"><draw:line text:anchor-type="paragraph" draw:z-index="334" draw:name="가로선 7" draw:style-name="gr4" draw:text-style-name="P24" svg:x1="0.879cm" svg:y1="0.097cm" svg:x2="7.187cm" svg:y2="0.097cm">
     <text:p/>
    </draw:line>둘러싸다 / 동봉하다 / 포함하다</text:p>
   <text:p text:style-name="P43">enclose</text:p>
   <text:p text:style-name="P44">둘러싸다 / 동봉하다 / 포함하다</text:p>
   <text:p text:style-name="P45"><draw:line text:anchor-type="paragraph" draw:z-index="336" draw:name="가로선 9" draw:style-name="gr5" draw:text-style-name="P31" svg:x1="0.847cm" svg:y1="0.237cm" svg:x2="7.155cm" svg:y2="0.237cm">
     <text:p/>
    </draw:line>편지에 서류를 동봉했습니다.</text:p>
   <text:p text:style-name="P46">I enclose the document in the letter.</text:p>
   <text:p text:style-name="P47">편지에 서류를 동봉했습니다.</text:p>
   <text:p text:style-name="P34">Please notify me if the schedule changes.</text:p>
   <text:p text:style-name="P10"><draw:line text:anchor-type="paragraph" draw:z-index="5" draw:name="가로선 10" draw:style-name="gr1" draw:text-style-name="P11" svg:x1="4.035cm" svg:y1="0.251cm" svg:x2="5.174cm" svg:y2="0.251cm">
     <text:p/>
    </draw:line>Third Sentence<text:span text:style-name="T1">.</text:span></text:p>
   <text:p text:style-name="P12"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P35">Please notify me if the schedule changes.<text:span text:style-name="T8"/></text:p>
   <text:p text:style-name="P36"/>
   <text:p text:style-name="P36"/>
