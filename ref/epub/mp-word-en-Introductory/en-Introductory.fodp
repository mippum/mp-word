    <draw:frame draw:style-name="gr17" draw:text-style-name="P22" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.6cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">~</text:span><text:span text:style-name="T10">로부터</text:span><text:span text:style-name="T10">, ~</text:span><text:span text:style-name="T10">에서 </text:span></text:p>
