   <draw:page draw:name="page8" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P21" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.7cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">이것은 마지막 케이크 조각이다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P22" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="10.7cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">마지막</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">지난 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="12.3cm" svg:x2="9.5cm" svg:y2="12.3cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.9cm" svg:x2="9.5cm" svg:y2="2.9cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="10.5cm" svg:x2="9.5cm" svg:y2="10.5cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.6cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[læst]</text:span><text:span text:style-name="T11"> <text:s text:c="4"/>UK:</text:span><text:span text:style-name="T12"> [lɑːst]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr28" draw:text-style-name="P25" draw:layer="layout" svg:width="2.051cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.61cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">LAST</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr29" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="6.115cm" svg:x="0.385cm" svg:y="4.1cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Last means coming at the end or most recent. It can describe the final thing in a list or event. People say &apos;last week&apos; or &apos;last night&apos; to talk about something that already happened. It can also mean continue, as in &apos;The show will last two hours.&apos; Example: &apos;This is the last piece of cake.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P34" draw:layer="layout" svg:width="10.5cm" svg:height="1.299cm" svg:x="0cm" svg:y="12.401cm">
     <draw:text-box>
      <text:p text:style-name="P33"><text:span text:style-name="T5">This is the last piece of cake. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.347cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
