    <draw:frame draw:style-name="gr48" draw:text-style-name="P21" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">오늘은 날씨가 정말 좋다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P22" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.6cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">오늘 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
