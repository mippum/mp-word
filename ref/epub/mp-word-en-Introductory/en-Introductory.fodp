    <draw:frame draw:style-name="gr32" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">불 좀 꺼주세요</text:span><text:span text:style-name="T1">. </text:span></text:p>
