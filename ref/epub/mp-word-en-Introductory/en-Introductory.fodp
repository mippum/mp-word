   <draw:page draw:name="page63" draw:style-name="dp3" draw:master-page-name="기본값">
    <draw:frame draw:style-name="gr17" draw:text-style-name="P21" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">저는 한국에서 왔어요</text:span><text:span text:style-name="T1">. </text:span></text:p>
