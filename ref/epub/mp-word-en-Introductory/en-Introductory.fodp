    <draw:frame draw:style-name="gr13" draw:text-style-name="P38" draw:layer="layout" svg:width="3cm" svg:height="1.504cm" svg:x="6.8cm" svg:y="9.409cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T6">They</text:span></text:p>
