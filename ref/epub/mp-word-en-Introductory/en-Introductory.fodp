     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[daʊn]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P25" draw:layer="layout" svg:width="2.499cm" svg:height="1.191cm" svg:x="4.03cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">DOWN</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="4.1cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Down means moving to a lower place or level. It can describe direction, like going down stairs. People use it to mean sadness, as in &apos;feeling down.&apos; Example: &apos;He sat down on the chair.&apos; It is often the opposite of up. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">He walks down the hill. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.347cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
