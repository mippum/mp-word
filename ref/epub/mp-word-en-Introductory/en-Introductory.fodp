    <draw:frame draw:style-name="gr37" draw:text-style-name="P25" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.53cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p text:style-name="P37"><text:span text:style-name="T15">ON</text:span></text:p>
