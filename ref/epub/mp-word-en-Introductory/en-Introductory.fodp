    <draw:frame draw:style-name="gr48" draw:text-style-name="P44" draw:layer="layout" svg:width="10.5cm" svg:height="1.395cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">이 선물은 당신을 위한 거예요</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
