     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US:</text:span><text:span text:style-name="T17"> [ˈʌndər] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> [ˈʌndə]</text:span></text:p>
