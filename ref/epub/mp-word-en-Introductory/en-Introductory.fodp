    <draw:frame draw:style-name="gr44" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.445cm" svg:x="0.385cm" svg:y="4.3cm">
     <draw:text-box>
      <text:p text:style-name="P46"><text:span text:style-name="T13">And is a word used to join two or more ideas together. For example, &apos;I like apples and bananas&apos; means you like both. It makes sentences longer and connects thoughts smoothly.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
