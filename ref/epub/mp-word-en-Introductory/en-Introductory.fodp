    <draw:frame draw:style-name="gr41" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Want means to wish for something or feel a need. For example, &apos;I want pizza&apos; means you feel like eating pizza. It shows desire or preference. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr53" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="12.001cm">
