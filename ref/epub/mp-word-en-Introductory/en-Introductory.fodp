    <draw:frame draw:style-name="gr38" draw:text-style-name="P55" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.7cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Or is a word used to show choice between two or more things. For example, &apos;Do you want tea or coffee?&apos; It helps ask about options or possibilities. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
