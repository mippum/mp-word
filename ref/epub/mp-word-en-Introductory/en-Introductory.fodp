    <draw:frame draw:style-name="gr27" draw:text-style-name="P51" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P50"><text:span text:style-name="T5">The weather is very cold today. </text:span></text:p>
     </draw:text-box>
