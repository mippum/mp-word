     <draw:text-box>
      <text:p><text:span text:style-name="T12">IN</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">In is a word that shows something is inside a place or time. For example, &apos;in the box&apos; means inside the box, and &apos;in the morning&apos; means during that time. It helps explain location or situation. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="12.201cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">The cat is in the box. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
