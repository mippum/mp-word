   <draw:page draw:name="page73" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">우리는 산책하러 나갔다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P54" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="10.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">밖에</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">밖으로 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr18" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.8cm" svg:x2="9.5cm" svg:y2="11.8cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.5cm" svg:x2="9.5cm" svg:y2="2.5cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="9.8cm" svg:x2="9.5cm" svg:y2="9.8cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr20" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.4cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[aʊt]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr68" draw:text-style-name="P25" draw:layer="layout" svg:width="1.863cm" svg:height="1.191cm" svg:x="4.33cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">OUT</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr35" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="5.382cm" svg:x="0.385cm" svg:y="3.8cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Out means moving from the inside to the outside. It can describe leaving a house, room, or container. People use it in many phrases, like &apos;go out,&apos; &apos;take out,&apos; or &apos;run out.&apos; It can also mean not available, like &apos;out of stock.&apos; Example: &apos;She went out to meet her friends.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr67" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">We go out for a walk. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.047cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
