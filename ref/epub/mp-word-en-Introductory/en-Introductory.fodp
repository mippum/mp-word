    <draw:frame draw:style-name="gr27" draw:text-style-name="P16" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T5">The night is quiet. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr13" draw:text-style-name="P47" draw:layer="layout" svg:width="3cm" svg:height="1.504cm" svg:x="6.8cm" svg:y="9.409cm">
     <draw:text-box>
