     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[ˈpiːpl]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr81" draw:text-style-name="P25" draw:layer="layout" svg:width="2.985cm" svg:height="1.191cm" svg:x="3.83cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">PEOPLE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">People are men, women, and children together. The word means more than one person. People live in towns, cities, and countries. They work, play, and share culture. Example: &apos;Many people came to the party.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr26" draw:text-style-name="P33" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.2cm" svg:y="11.501cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T5">There are many people in the room. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.247cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
