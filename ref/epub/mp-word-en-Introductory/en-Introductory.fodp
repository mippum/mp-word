     <draw:text-box>
      <text:p><text:span text:style-name="T13">TOMORROW</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr63" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="2.45cm" svg:x="0.385cm" svg:y="5.7cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Tomorrow is the day after today. It has not happened yet. For example, &apos;Tomorrow we will go to the park.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P33" draw:layer="layout" svg:width="10.5cm" svg:height="1.299cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T5">We have a meeting tomorrow. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.947cm">
