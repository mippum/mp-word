     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[ˈwɔːtər]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr51" draw:text-style-name="P25" draw:layer="layout" svg:width="2.662cm" svg:height="1.191cm" svg:x="4.03cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">WATER</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.3cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Water is a clear liquid that people, animals, and plants need to survive. We drink it, cook with it, and use it every day. For example, &apos;I drink water when I am thirsty.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr52" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="12.001cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">I drink water. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.547cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
