    <draw:frame draw:style-name="gr58" draw:text-style-name="P25" draw:layer="layout" svg:width="2.578cm" svg:height="1.191cm" svg:x="3.93cm" svg:y="0.81cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">TODAY</text:span></text:p>
     </draw:text-box>
