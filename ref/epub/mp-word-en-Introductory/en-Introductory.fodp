   <draw:page draw:name="page107" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr85" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="0.9cm" svg:x="0cm" svg:y="13.4cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">그 길은 길고 구불구불해</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P54" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.8cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">긴</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">오랫동안 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr18" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.6cm" svg:x2="9.5cm" svg:y2="11.6cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.6cm" svg:x2="9.5cm" svg:y2="2.6cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="9.2cm" svg:x2="9.5cm" svg:y2="9.2cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr20" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.5cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[lɔːŋ]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr86" draw:text-style-name="P25" draw:layer="layout" svg:width="2.264cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">LONG</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="3.9cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Long describes something that measures much from end to end. It can also mean lasting a lot of time. People say &apos;a long road&apos; or &apos;a long day.&apos; Example: &apos;The movie was very long.&apos; It is the opposite of short. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr87" draw:text-style-name="P67" draw:layer="layout" svg:width="10.5cm" svg:height="1.199cm" svg:x="0cm" svg:y="12.101cm">
     <draw:text-box>
      <text:p text:style-name="P66"><text:span text:style-name="T5">The road is long and winding. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.147cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp3">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
