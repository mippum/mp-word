     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">~</text:span><text:span text:style-name="T10">안에</text:span><text:span text:style-name="T10">, ~</text:span><text:span text:style-name="T10">에서 </text:span></text:p>
