     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[raɪt] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> []</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr80" draw:text-style-name="P25" draw:layer="layout" svg:width="2.477cm" svg:height="1.191cm" svg:x="4.03cm" svg:y="0.61cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">RIGHT</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Right can mean correct, like giving the right answer. It can also mean the opposite of left in direction. People use &apos;right now&apos; to show immediacy. Example: &apos;Turn right at the corner.&apos; Right is often about correctness or direction. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">You are right about that. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.247cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
