    <draw:frame draw:style-name="gr33" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="3.3cm" svg:x="0.385cm" svg:y="5cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Here means in this place. It shows that something is close to the speaker. Example: &apos;Come here, please.&apos; People use it to point to a location or presence. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
