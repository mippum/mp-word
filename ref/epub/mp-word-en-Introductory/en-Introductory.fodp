    <draw:frame draw:style-name="gr41" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.8cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">A woman is an adult female human. Women are often daughters, sisters, mothers, or workers in society. For example, &apos;The woman is a teacher.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
