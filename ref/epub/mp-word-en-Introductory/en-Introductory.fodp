    <draw:frame draw:style-name="gr62" draw:text-style-name="P25" draw:layer="layout" svg:width="2.444cm" svg:height="1.191cm" svg:x="4.03cm" svg:y="0.91cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">LATER</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr60" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="2.45cm" svg:x="0.385cm" svg:y="5.3cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Later means after the present time. For example, &apos;I will call you later.&apos; It shows something will happen afterward. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">It will rain later. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.547cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
