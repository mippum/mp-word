     <draw:text-box>
      <text:p><text:span text:style-name="T13">BIG</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr63" draw:text-style-name="P36" draw:layer="layout" svg:width="9.915cm" svg:height="2.45cm" svg:x="0.385cm" svg:y="5.6cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Big means large in size or amount. For example, &apos;The elephant is big.&apos; It is the opposite of small. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">The house is big. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.847cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
