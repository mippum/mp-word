    <draw:frame draw:style-name="gr18" draw:text-style-name="P22" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">밤 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
