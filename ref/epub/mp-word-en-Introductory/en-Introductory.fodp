   <draw:page draw:name="page107" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr32" draw:text-style-name="P64" draw:layer="layout" svg:width="10.5cm" svg:height="1cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">뭐라고 했어</text:span><text:span text:style-name="T1">? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P65" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.8cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">말하다 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.6cm" svg:x2="9.5cm" svg:y2="2.6cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="9.3cm" svg:x2="9.5cm" svg:y2="9.3cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.4cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[seɪ] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> []</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr40" draw:text-style-name="P25" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.33cm" svg:y="0.41cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">SAY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Say means to speak words. People say hello, thank you, or important ideas. It can also mean repeat what someone else said. Example: &apos;She says she is tired.&apos; It is one of the most common verbs in English. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">What did you say? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.247cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
