    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.3cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">They is used to talk about more than one person, animal, or thing. For example, &apos;They are my friends&apos; means several people are friends. It avoids repeating names. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">They are my friends. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
