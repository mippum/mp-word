    <draw:frame draw:style-name="gr32" draw:text-style-name="P25" draw:layer="layout" svg:width="2.197cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.91cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">HERE</text:span></text:p>
