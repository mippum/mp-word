    <draw:frame draw:style-name="gr17" draw:text-style-name="P21" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">그들은 내 친구이다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P22" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">그들</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">그 사람들 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
