    <draw:frame draw:style-name="gr22" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">On shows that something is above and touching a surface, like &apos;The book is on the table&apos;. It also talks about time and activities, such as &apos;on Monday&apos; or &apos;on TV&apos;. It is a very common preposition in English. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">The book is on the table. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
