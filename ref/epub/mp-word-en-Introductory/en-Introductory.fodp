     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">영화 몇 시에 시작해</text:span><text:span text:style-name="T1">? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P56" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="10cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">시간 </text:span></text:p>
     </draw:text-box>
