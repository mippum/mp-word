    <draw:frame draw:style-name="gr21" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.5cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[fɔːr] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> []</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr40" draw:text-style-name="P25" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">FOR</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.2cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">For is a word that shows purpose, reason, or benefit. For example, &apos;This gift is for you&apos; means the gift is meant to be yours. It also explains time, like &apos;for two hours&apos;. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr49" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">This gift is for you. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.447cm">
     <draw:text-box>
