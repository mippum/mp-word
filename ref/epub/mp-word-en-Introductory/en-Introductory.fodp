    <draw:frame draw:style-name="gr35" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="5.382cm" svg:x="0.385cm" svg:y="3.8cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Now means the present time. It shows what is happening at this very moment. People use &apos;now&apos; to talk about something urgent or immediate. Example: &apos;Please come here now.&apos; It makes the action feel current and important. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="12.001cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">Do you have any money? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
