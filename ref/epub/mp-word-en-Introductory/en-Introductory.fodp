   <draw:page draw:name="page105" draw:style-name="dp3" draw:master-page-name="기본값">
    <draw:frame draw:style-name="gr17" draw:text-style-name="P64" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.092cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">나는 이 노래가 정말 좋아</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P65" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">정말로</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">실제로 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.6cm" svg:x2="9.5cm" svg:y2="11.6cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.9cm" svg:x2="9.5cm" svg:y2="2.9cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.9cm" svg:x2="9.5cm" svg:y2="8.9cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.5cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[ˈriːəli, ˈrɪəli] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> []</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr86" draw:text-style-name="P25" draw:layer="layout" svg:width="2.775cm" svg:height="1.191cm" svg:x="3.83cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">REALLY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.4cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Really means truly or in fact. It makes words stronger, like &apos;really good&apos; or &apos;really fast.&apos; People use it to show honesty or surprise. Example: &apos;Do you really mean it?&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">I really like this song. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.647cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr4" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="105" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P8" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
