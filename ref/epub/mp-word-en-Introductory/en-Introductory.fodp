     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[sʌn] </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr61" draw:text-style-name="P25" draw:layer="layout" svg:width="1.849cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.81cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">SUN</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr38" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.8cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">The sun is a big star that gives light and heat to Earth. It rises in the morning and sets in the evening. For example, &apos;The sun is bright today.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr26" draw:text-style-name="P33" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.2cm" svg:y="11.301cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T5">The sun is shining brightly today. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.047cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
