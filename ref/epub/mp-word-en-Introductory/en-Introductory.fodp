    <draw:frame draw:style-name="gr92" draw:text-style-name="P25" draw:layer="layout" svg:width="2.672cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.91cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">OTHER</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr34" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="3.3cm" svg:x="0.385cm" svg:y="5cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Other means not the one you already mentioned. For example, &apos;I like this book, but I want the other one.&apos; It shows difference or additional options. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="10cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">I like the other book.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.247cm">
     <draw:text-box>
