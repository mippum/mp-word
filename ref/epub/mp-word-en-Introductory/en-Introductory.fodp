    <draw:frame draw:style-name="gr74" draw:text-style-name="P25" draw:layer="layout" svg:width="2.079cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.61cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">VERY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.3cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Very means to a high degree. It makes words stronger, like &apos;very big&apos; or &apos;very happy.&apos; People use it to show strong feelings. Example: &apos;She is very smart.&apos; It helps make language more expressive. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr29" draw:text-style-name="P33" draw:layer="layout" svg:width="10.5cm" svg:height="1.299cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T5">The weather is very cold today. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.547cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
