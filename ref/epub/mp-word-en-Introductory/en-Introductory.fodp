   <draw:page draw:name="page95" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr32" draw:text-style-name="P55" draw:layer="layout" svg:width="10.5cm" svg:height="1cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">그건 네가 맞아</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P56" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">오른쪽</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">옳은 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.7cm" svg:x2="9.5cm" svg:y2="2.7cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="9.1cm" svg:x2="9.5cm" svg:y2="9.1cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.6cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[raɪt] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> []</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr80" draw:text-style-name="P25" draw:layer="layout" svg:width="2.477cm" svg:height="1.191cm" svg:x="4.03cm" svg:y="0.61cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">RIGHT</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Right can mean correct, like giving the right answer. It can also mean the opposite of left in direction. People use &apos;right now&apos; to show immediacy. Example: &apos;Turn right at the corner.&apos; Right is often about correctness or direction. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">You are right about that. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.247cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr4" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="95" presentation:class="page"/>
