   <draw:page draw:name="page75" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.7cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">영화 몇 시에 시작해</text:span><text:span text:style-name="T1">? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P54" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="10cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">시간 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr18" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.2cm" svg:x2="9.5cm" svg:y2="2.2cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="9.7cm" svg:x2="9.5cm" svg:y2="9.7cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr20" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.1cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[taɪm]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr69" draw:text-style-name="P25" draw:layer="layout" svg:width="2.041cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">TIME</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr28" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="6.115cm" svg:x="0.385cm" svg:y="3.3cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Time is what we measure with seconds, minutes, and hours. It tells us when things happen and how long they last. People talk about time with clocks, calendars, and seasons. Time can pass quickly or slowly depending on what you do. Example: &apos;I don’t have much time today.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr26" draw:text-style-name="P33" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.5cm" svg:y="11.701cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T5">What time does the movie start? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.547cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
