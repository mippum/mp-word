    <draw:line draw:style-name="gr20" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.7cm" svg:x2="9.5cm" svg:y2="8.7cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.5cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T16">US: </text:span><text:span text:style-name="T17">[bɪˈfɔːr] <text:s text:c="4"/></text:span><text:span text:style-name="T11">UK:</text:span><text:span text:style-name="T12"> []</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr85" draw:text-style-name="P25" draw:layer="layout" svg:width="3.001cm" svg:height="1.191cm" svg:x="3.93cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T13">BEFORE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.1cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T14">Before means earlier than something in time. Breakfast comes before lunch. It can also mean in front of in space. Example: &apos;She stood before the class.&apos; It shows both time and position. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr27" draw:text-style-name="P33" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.7cm" svg:y="11.201cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T5">Wash your hands before dinner. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.347cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T15">(</text:span><text:span text:style-name="T15">영영사전</text:span><text:span text:style-name="T15">) </text:span><text:span text:style-name="T15">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
