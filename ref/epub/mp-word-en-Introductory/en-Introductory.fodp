   <draw:page draw:name="page26" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr31" draw:text-style-name="P42" draw:layer="layout" svg:width="10.5cm" svg:height="1cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T1">불 좀 꺼주세요</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P22" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T10">~</text:span><text:span text:style-name="T10">에서 떨어져</text:span><text:span text:style-name="T10">, </text:span><text:span text:style-name="T10">꺼져 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr18" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.4cm" svg:x2="9.5cm" svg:y2="2.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr19" draw:text-style-name="P23" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.5cm" svg:x2="9.5cm" svg:y2="8.5cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr20" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T11">[ɔːf]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr37" draw:text-style-name="P25" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.33cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">OFF</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">Off means away from or not working. Lights can be off, or someone can take off shoes. It shows separation from something. Example: &apos;The TV is off.&apos; It is often the opposite of on. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">Please turn off the lights. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
