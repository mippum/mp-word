    <draw:frame draw:style-name="gr38" draw:text-style-name="P35" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.7cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">At shows a specific place or time. For example, &apos;She is at school&apos; means her location is school. It can also describe time, like &apos;at 7 o’clock&apos;. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">I am at home. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.947cm">
     <draw:text-box>
