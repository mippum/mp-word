     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr20" draw:text-style-name="P24" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="2.1cm">
     <draw:text-box>
      <text:p text:style-name="P20"><text:span text:style-name="T11">[ʃiː]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P25" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.33cm" svg:y="1.21cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">SHE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P27" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.7cm">
     <draw:text-box>
      <text:p text:style-name="P26"><text:span text:style-name="T13">She is used to talk about a girl or a woman. It replaces the name to avoid repetition. For example, &apos;This is Anna. She is kind.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T5">She likes me. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr23" draw:text-style-name="P30" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T14">(</text:span><text:span text:style-name="T14">영영사전</text:span><text:span text:style-name="T14">) </text:span><text:span text:style-name="T14">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
