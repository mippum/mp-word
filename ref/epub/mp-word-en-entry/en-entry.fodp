    <draw:frame draw:style-name="gr78" draw:text-style-name="P31" draw:layer="layout" svg:width="2.836cm" svg:height="1.191cm" svg:x="3.93cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">FRIEND</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P68" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">A friend is a person you like and spend time with. Friends support and help each other. For example, &apos;My friend plays with me.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">She is my friend. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P66" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.847cm">
