    <draw:frame draw:style-name="gr85" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="3.3cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P55"><text:span text:style-name="T29">A school is a place where children and students learn. Teachers help them study subjects like math, reading, and science. For example, &apos;I go to school every day.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P39"><text:span text:style-name="T20">I go to school every day. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
