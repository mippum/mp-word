     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T18">[iːt]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr72" draw:text-style-name="P30" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.33cm" svg:y="0.81cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">EAT</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr78" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.8cm">
     <draw:text-box>
      <text:p text:style-name="P55"><text:span text:style-name="T29">Eat means to take food into your mouth and chew or swallow it. For example, &apos;I eat rice every day.&apos; Eating gives your body energy to live and grow. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P39"><text:span text:style-name="T20">We eat lunch together. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P65" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.047cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T30">(</text:span><text:span text:style-name="T30">영영사전</text:span><text:span text:style-name="T30">) </text:span><text:span text:style-name="T30">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
