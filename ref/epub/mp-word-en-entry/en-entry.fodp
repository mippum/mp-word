   <draw:page draw:name="page84" draw:style-name="dp3" draw:master-page-name="기본값">
    <draw:frame draw:style-name="gr47" draw:text-style-name="P51" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T1">그 소녀는 행복하다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P71" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="10.1cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T28">소녀</text:span><text:span text:style-name="T28">, </text:span><text:span text:style-name="T28">여자아이</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr26" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.5cm" svg:x2="9.5cm" svg:y2="11.5cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.6cm" svg:x2="9.5cm" svg:y2="2.6cm">
