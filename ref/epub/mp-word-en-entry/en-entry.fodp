    <draw:frame draw:style-name="gr68" draw:text-style-name="P72" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="10.1cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T28">소녀</text:span><text:span text:style-name="T28">, </text:span><text:span text:style-name="T28">여자아이</text:span></text:p>
