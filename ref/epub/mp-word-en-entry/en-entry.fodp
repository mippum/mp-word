    <draw:frame draw:style-name="gr69" draw:text-style-name="P31" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.53cm" svg:y="0.71cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">HE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="9.915cm" svg:height="3.4cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">He is a word used instead of a man or boy’s name. For example, &apos;This is John. He is my friend.&apos; It is a subject pronoun that helps avoid repeating names. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P66" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.847cm">
