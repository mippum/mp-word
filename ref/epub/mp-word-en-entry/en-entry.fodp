   <draw:page draw:name="page78" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr46" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="12.8cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T1">나는 사과 하나를 가지고 있다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr68" draw:text-style-name="P71" draw:layer="layout" svg:width="3cm" svg:height="1.102cm" svg:x="3.6cm" svg:y="9.2cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T28">하나</text:span><text:span text:style-name="T28">, 1 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr26" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.2cm" svg:x2="9.5cm" svg:y2="11.2cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="3cm" svg:x2="9.5cm" svg:y2="3cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.5cm" svg:x2="9.5cm" svg:y2="8.5cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P64" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.7cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[wʌn]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr73" draw:text-style-name="P31" draw:layer="layout" svg:width="1.857cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.71cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">ONE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P68" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.4cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">One is the number 1. It can also mean a single person or thing, like &apos;one apple&apos;. Sometimes it is used to replace a noun, as in &apos;This is a good one&apos;. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.701cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">I have one apple. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P66" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.647cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T30">(</text:span><text:span text:style-name="T30">영영사전</text:span><text:span text:style-name="T30">) </text:span><text:span text:style-name="T30">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
