    <draw:frame draw:style-name="gr73" draw:text-style-name="P64" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.7cm">
     <draw:text-box>
      <text:p text:style-name="P55"><text:span text:style-name="T29">She is used to talk about a girl or a woman. It replaces the name to avoid repetition. For example, &apos;This is Anna. She is kind.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P39"><text:span text:style-name="T20">She likes me. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P65" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.947cm">
