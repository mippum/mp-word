    <draw:frame draw:style-name="gr76" draw:text-style-name="P31" draw:layer="layout" svg:width="1.966cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">GIRL</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr77" draw:text-style-name="P65" draw:layer="layout" svg:width="9.915cm" svg:height="5.382cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">A girl is a female child or young woman. Girls can be daughters, sisters, or friends. They go to school, play, and learn just like boys. The word &apos;girl&apos; is often used to talk about age before someone becomes a woman. Example: &apos;The girl is reading a storybook.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">The girl is happy. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P66" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.147cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T30">(</text:span><text:span text:style-name="T30">영영사전</text:span><text:span text:style-name="T30">) </text:span><text:span text:style-name="T30">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
