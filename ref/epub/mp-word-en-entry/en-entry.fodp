    <draw:frame draw:style-name="gr24" draw:text-style-name="P64" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[ɡɜːrl]</text:span></text:p>
