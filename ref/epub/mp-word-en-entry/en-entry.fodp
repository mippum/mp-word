   <draw:page draw:name="page76" draw:style-name="dp3" draw:master-page-name="기본값">
    <draw:frame draw:style-name="gr47" draw:text-style-name="P51" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T1">그 남자는 키가 크다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr76" draw:text-style-name="P69" draw:layer="layout" svg:width="10.5cm" svg:height="2.103cm" svg:x="0cm" svg:y="9.1cm">
     <draw:text-box>
      <text:p text:style-name="P68"><text:span text:style-name="T31">그</text:span><text:span text:style-name="T31">, </text:span><text:span text:style-name="T31">저</text:span></text:p>
      <text:p text:style-name="P27"><text:span text:style-name="T32">(</text:span><text:span text:style-name="T33">정관사</text:span><text:span text:style-name="T32">. </text:span><text:span text:style-name="T33">특정한 것을 가리킬 때 사용</text:span><text:span text:style-name="T32">)</text:span><text:span text:style-name="T34"> </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr26" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.6cm" svg:x2="9.5cm" svg:y2="11.6cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.7cm" svg:x2="9.5cm" svg:y2="2.7cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.6cm" svg:x2="9.5cm" svg:y2="8.6cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P63" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.6cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T18">[ðə, ðiː]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr72" draw:text-style-name="P30" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.43cm" svg:y="0.61cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">THE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr73" draw:text-style-name="P64" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P55"><text:span text:style-name="T29">The is a word used before nouns to talk about something specific. For example, &apos;the dog&apos; means one particular dog, not any dog. It helps make sentences more clear and exact. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P39"><text:span text:style-name="T20">The man is tall. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P65" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.247cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T30">(</text:span><text:span text:style-name="T30">영영사전</text:span><text:span text:style-name="T30">) </text:span><text:span text:style-name="T30">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
