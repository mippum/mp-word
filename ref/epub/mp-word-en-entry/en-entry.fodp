    <draw:frame draw:style-name="gr75" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="3.4cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P55"><text:span text:style-name="T29">He is a word used instead of a man or boy’s name. For example, &apos;This is John. He is my friend.&apos; It is a subject pronoun that helps avoid repeating names. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
