    <draw:frame draw:style-name="gr68" draw:text-style-name="P63" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T28">그 </text:span><text:span text:style-name="T28">/ </text:span><text:span text:style-name="T28">그 남자 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
