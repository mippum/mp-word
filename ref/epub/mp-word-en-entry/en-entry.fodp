    <draw:frame draw:style-name="gr74" draw:text-style-name="P68" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.9cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">A house is a building where people live. It usually has rooms like a kitchen, bedroom, and bathroom. For example, &apos;My family lives in a house.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">This is my house. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
