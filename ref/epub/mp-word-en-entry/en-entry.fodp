   <draw:page draw:name="page92" draw:style-name="dp3" draw:master-page-name="기본값">
    <draw:frame draw:style-name="gr46" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T1">우리는 함께 점심을 먹는다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr68" draw:text-style-name="P63" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T28">먹다 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr26" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="3.2cm" svg:x2="9.5cm" svg:y2="3.2cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="9cm" svg:x2="9.5cm" svg:y2="9cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P64" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.8cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[iːt]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr69" draw:text-style-name="P31" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.33cm" svg:y="0.81cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">EAT</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P68" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.8cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">Eat means to take food into your mouth and chew or swallow it. For example, &apos;I eat rice every day.&apos; Eating gives your body energy to live and grow. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">We eat lunch together. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P66" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="4.047cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T30">(</text:span><text:span text:style-name="T30">영영사전</text:span><text:span text:style-name="T30">) </text:span><text:span text:style-name="T30">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
