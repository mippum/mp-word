    <draw:frame draw:style-name="gr47" draw:text-style-name="P51" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="12.8cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T1">나는 사과 하나를 가지고 있다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
