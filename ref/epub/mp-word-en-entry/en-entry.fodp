    <draw:frame draw:style-name="gr73" draw:text-style-name="P31" draw:layer="layout" svg:width="1.857cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.71cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">ONE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr74" draw:text-style-name="P68" draw:layer="layout" svg:width="9.915cm" svg:height="3.183cm" svg:x="0.385cm" svg:y="4.4cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T29">One is the number 1. It can also mean a single person or thing, like &apos;one apple&apos;. Sometimes it is used to replace a noun, as in &apos;This is a good one&apos;. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.701cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">I have one apple. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P66" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.647cm">
