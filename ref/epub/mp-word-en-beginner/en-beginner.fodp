    <draw:frame draw:style-name="gr25" draw:text-style-name="P66" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.6cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[læst]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr91" draw:text-style-name="P31" draw:layer="layout" svg:width="2.051cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.61cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">LAST</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr92" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="6.115cm" svg:x="0.385cm" svg:y="4.1cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">Last means coming at the end or most recent. It can describe the final thing in a list or event. People say &apos;last week&apos; or &apos;last night&apos; to talk about something that already happened. It can also mean continue, as in &apos;The show will last two hours.&apos; Example: &apos;This is the last piece of cake.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr93" draw:text-style-name="P61" draw:layer="layout" svg:width="10.5cm" svg:height="1.299cm" svg:x="0cm" svg:y="12.401cm">
     <draw:text-box>
      <text:p text:style-name="P60"><text:span text:style-name="T20">This is the last piece of cake. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.347cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
