    <draw:frame draw:style-name="gr58" draw:text-style-name="P82" draw:layer="layout" svg:width="4.6cm" svg:height="1.395cm" svg:x="3cm" svg:y="13.6cm">
     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T1">그 길은 길고 구불구불해</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr69" draw:text-style-name="P74" draw:layer="layout" svg:width="3cm" svg:height="2.804cm" svg:x="3.6cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T25">긴</text:span><text:span text:style-name="T25">, </text:span><text:span text:style-name="T25">오랫동안 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr27" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr23" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.4cm" svg:x2="9.5cm" svg:y2="2.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr23" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.5cm" svg:x2="9.5cm" svg:y2="8.5cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P33" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T18">[lɔːŋ]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P31" draw:layer="layout" svg:width="2.264cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">LONG</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="4.649cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P88"><text:span text:style-name="T26">Long describes something that measures much from end to end. It can also mean lasting a lot of time. People say &apos;a long road&apos; or &apos;a long day.&apos; Example: &apos;The movie was very long.&apos; It is the opposite of short. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr13" draw:text-style-name="P94" draw:layer="layout" svg:width="10.5cm" svg:height="2.039cm" svg:x="0cm" svg:y="11.701cm">
     <draw:text-box>
      <text:p text:style-name="P93"><text:span text:style-name="T20">The road is long and winding. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr4" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="196" presentation:class="page"/>
