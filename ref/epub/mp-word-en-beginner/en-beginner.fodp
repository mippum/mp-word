    <draw:frame draw:style-name="gr39" draw:text-style-name="P47" draw:layer="layout" svg:width="4.6cm" svg:height="1.395cm" svg:x="3cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T1">차 한 잔 마시고 싶어요</text:span><text:span text:style-name="T1">. </text:span></text:p>
