    <draw:frame draw:style-name="gr40" draw:text-style-name="P30" draw:layer="layout" svg:width="2.469cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">SLEEP</text:span></text:p>
