    <draw:frame draw:style-name="gr97" draw:text-style-name="P31" draw:layer="layout" svg:width="2.594cm" svg:height="1.191cm" svg:x="3.93cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">THERE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr80" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="5.382cm" svg:x="0.385cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">There refers to a place that is not here. It can point to something far away or just not close. People also use &apos;there is&apos; or &apos;there are&apos; to show that something exists. For example, &apos;There is a book on the table.&apos; It helps make sentences clear and complete. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr98" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="12.29cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">There is a park near my house. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.247cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
