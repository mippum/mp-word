    <draw:frame draw:style-name="gr29" draw:text-style-name="P35" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T20">Do you want tea or coffee? </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P17" draw:layer="layout" svg:width="3cm" svg:height="1.504cm" svg:x="7.3cm" svg:y="9.109cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T6">or</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P18" draw:layer="layout" svg:width="3cm" svg:height="1cm" svg:x="7cm" svg:y="8.5cm">
