     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[ɪn]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P31" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.63cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">IN</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">In is a word that shows something is inside a place or time. For example, &apos;in the box&apos; means inside the box, and &apos;in the morning&apos; means during that time. It helps explain location or situation. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr35" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="12.201cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">The cat is in the box. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.847cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
