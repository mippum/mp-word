     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P66" draw:layer="layout" svg:width="10.5cm" svg:height="0.772cm" svg:x="0cm" svg:y="1.5cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[sliːp]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr88" draw:text-style-name="P31" draw:layer="layout" svg:width="2.469cm" svg:height="1.191cm" svg:x="4.13cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">SLEEP</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.1cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">Sleep is the natural rest your body needs every night. During sleep, you close your eyes and your body recovers energy. Without enough sleep, people feel tired and cannot think or work well. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr34" draw:text-style-name="P61" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.7cm" svg:y="11.301cm">
     <draw:text-box>
      <text:p text:style-name="P60"><text:span text:style-name="T20">The dog is sleeping on the couch. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.347cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
