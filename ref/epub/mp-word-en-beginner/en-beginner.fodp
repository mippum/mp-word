    <draw:frame draw:style-name="gr43" draw:text-style-name="P56" draw:layer="layout" svg:width="3cm" svg:height="1.102cm" svg:x="3.6cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T26">우리</text:span></text:p>
     </draw:text-box>
    </draw:frame>
