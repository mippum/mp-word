   <draw:page draw:name="page180" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr58" draw:text-style-name="P82" draw:layer="layout" svg:width="4.6cm" svg:height="1.385cm" svg:x="3cm" svg:y="13.7cm">
     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T1">신선한 공기를 위해 창문을 열어</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr69" draw:text-style-name="P74" draw:layer="layout" svg:width="3cm" svg:height="1.102cm" svg:x="3.6cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T25">창문</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr27" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr23" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.4cm" svg:x2="9.5cm" svg:y2="2.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr23" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.5cm" svg:x2="9.5cm" svg:y2="8.5cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P33" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T18">[ˈwɪndoʊ ]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr70" draw:text-style-name="P31" draw:layer="layout" svg:width="3.29cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">WINDOW</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="5.354cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P88"><text:span text:style-name="T26">A window is an opening in a wall with glass that lets in light and air. People look through windows to see outside. Windows can open or close for fresh air. Example: &apos;She opened the window to let in the breeze.&apos; They are found in most buildings and homes. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr34" draw:text-style-name="P61" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.3cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P60"><text:span text:style-name="T20">Open the window for some fresh air. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr4" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="180" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P8" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
