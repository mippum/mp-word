     <draw:text-box>
      <text:p text:style-name="P89"><text:span text:style-name="T20">There are many people in the room. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr41" draw:text-style-name="P17" draw:layer="layout" svg:width="3.8cm" svg:height="2.757cm" svg:x="6.5cm" svg:y="9.409cm">
