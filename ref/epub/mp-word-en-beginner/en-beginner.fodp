    <draw:frame draw:style-name="gr3" draw:text-style-name="P58" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T27">Here means in this place. It shows that something is close to the speaker. Example: &apos;Come here, please.&apos; People use it to point to a location or presence. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P55" draw:layer="layout" svg:width="10cm" svg:height="1.191cm" svg:x="1.4cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P44"><text:span text:style-name="T20">I am here. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
