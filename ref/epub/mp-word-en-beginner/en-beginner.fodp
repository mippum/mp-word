    <draw:frame draw:style-name="gr87" draw:text-style-name="P52" draw:layer="layout" svg:width="10.5cm" svg:height="0.823cm" svg:x="0cm" svg:y="13.5cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T1">그 개는 소파에서 자고 있다</text:span><text:span text:style-name="T1">. </text:span></text:p>
