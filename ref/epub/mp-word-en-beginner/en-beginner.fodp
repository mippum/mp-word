     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T18">[ðeɪ]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr99" draw:text-style-name="P31" draw:layer="layout" svg:width="2.139cm" svg:height="1.191cm" svg:x="4.13cm" svg:y="0.51cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">THEY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="4.3cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">They is used to talk about more than one person, animal, or thing. For example, &apos;They are my friends&apos; means several people are friends. It avoids repeating names. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr35" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P40"><text:span text:style-name="T20">They are my friends. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="3.547cm">
