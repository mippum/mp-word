    <draw:frame draw:style-name="gr58" draw:text-style-name="P82" draw:layer="layout" svg:width="4.6cm" svg:height="1cm" svg:x="3cm" svg:y="13.2cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T1">전 물을 마셔요</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
