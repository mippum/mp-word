    <draw:frame draw:style-name="gr3" draw:text-style-name="P58" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T27">Sleep is the natural rest your body needs every night. During sleep, you close your eyes and your body recovers energy. Without enough sleep, people feel tired and cannot think or work well. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr29" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.7cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P52"><text:span text:style-name="T20">The dog is sleeping on the couch. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr44" draw:text-style-name="P59" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T28">(</text:span><text:span text:style-name="T28">영영사전</text:span><text:span text:style-name="T28">) </text:span><text:span text:style-name="T28">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
