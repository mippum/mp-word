     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T25">~</text:span><text:span text:style-name="T25">에</text:span><text:span text:style-name="T25">, ~</text:span><text:span text:style-name="T25">에서 </text:span></text:p>
