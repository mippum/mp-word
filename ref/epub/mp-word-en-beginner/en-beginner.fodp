    <draw:frame draw:style-name="gr40" draw:text-style-name="P30" draw:layer="layout" svg:width="1.838cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">SHE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P58" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T27">She is used to talk about a girl or a woman. It replaces the name to avoid repetition. For example, &apos;This is Anna. She is kind.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P55" draw:layer="layout" svg:width="10cm" svg:height="1.191cm" svg:x="1.4cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P44"><text:span text:style-name="T20">She likes me. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr44" draw:text-style-name="P59" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T28">(</text:span><text:span text:style-name="T28">영영사전</text:span><text:span text:style-name="T28">) </text:span><text:span text:style-name="T28">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
