    <draw:frame draw:style-name="gr39" draw:text-style-name="P47" draw:layer="layout" svg:width="4.6cm" svg:height="1.395cm" svg:x="3cm" svg:y="13.5cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T1">오늘은 해가 밝게 빛나고 있다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr43" draw:text-style-name="P56" draw:layer="layout" svg:width="3cm" svg:height="1.102cm" svg:x="3.6cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T26">태양 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
