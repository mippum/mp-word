     <draw:text-box>
      <text:p text:style-name="P49"><text:span text:style-name="T1">차 마실래</text:span><text:span text:style-name="T1">? </text:span><text:span text:style-name="T1">커피 마실래</text:span><text:span text:style-name="T1">? </text:span></text:p>
