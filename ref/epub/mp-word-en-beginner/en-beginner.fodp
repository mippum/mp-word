     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P32" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T18">[ɡɜːrl]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr40" draw:text-style-name="P30" draw:layer="layout" svg:width="1.966cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">GIRL</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P58" draw:layer="layout" svg:width="9.915cm" svg:height="5.382cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T27">A girl is a female child or young woman. Girls can be daughters, sisters, or friends. They go to school, play, and learn just like boys. The word &apos;girl&apos; is often used to talk about age before someone becomes a woman. Example: &apos;The girl is reading a storybook.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P48" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P39"><text:span text:style-name="T20">The girl is happy. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr44" draw:text-style-name="P59" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T28">(</text:span><text:span text:style-name="T28">영영사전</text:span><text:span text:style-name="T28">) </text:span><text:span text:style-name="T28">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
