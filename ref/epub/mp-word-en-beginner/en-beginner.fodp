    <draw:frame draw:style-name="gr19" draw:text-style-name="P24" draw:layer="layout" svg:width="7cm" svg:height="1.115cm" svg:x="3.3cm" svg:y="13.5cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T16">안녕</text:span><text:span text:style-name="T16">! </text:span><text:span text:style-name="T16">난 지나야</text:span><text:span text:style-name="T16">.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P28" draw:layer="layout" svg:width="6.8cm" svg:height="4.375cm" svg:x="2.7cm" svg:y="7.225cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T1">be </text:span><text:span text:style-name="T14">동사의</text:span><text:span text:style-name="T1"> 원형 </text:span></text:p>
      <text:p><text:span text:style-name="T1">(am/are/is </text:span><text:span text:style-name="T1">등으로 활용</text:span><text:span text:style-name="T1">)</text:span></text:p>
      <text:p><text:span text:style-name="T1"/></text:p>
      <text:p><text:span text:style-name="T1">be </text:span><text:span text:style-name="T1">동사</text:span></text:p>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p><text:span text:style-name="T1">~</text:span><text:span text:style-name="T1">이다 </text:span><text:span text:style-name="T1">(</text:span><text:span text:style-name="T1">정체</text:span><text:span text:style-name="T1">, </text:span><text:span text:style-name="T1">성질</text:span><text:span text:style-name="T1">, </text:span><text:span text:style-name="T1">상태</text:span><text:span text:style-name="T1">)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T1">~</text:span><text:span text:style-name="T1">에 있다 </text:span><text:span text:style-name="T1">(</text:span><text:span text:style-name="T1">장소</text:span><text:span text:style-name="T1">, </text:span><text:span text:style-name="T1">위치</text:span><text:span text:style-name="T1">)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T1">~</text:span><text:span text:style-name="T1">하고 있다</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
