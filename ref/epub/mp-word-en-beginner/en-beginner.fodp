    <draw:frame draw:style-name="gr25" draw:text-style-name="P33" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T18">[ænd, ən(d)]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr104" draw:text-style-name="P31" draw:layer="layout" svg:width="2.019cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">AND</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr105" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="4.445cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P83"><text:span text:style-name="T26">And is a word used to join two or more ideas together. For example, &apos;I like apples and bananas&apos; means you like both. It makes sentences longer and connects thoughts smoothly.</text:span></text:p>
