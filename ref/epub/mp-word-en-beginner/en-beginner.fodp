    <draw:frame draw:style-name="gr69" draw:text-style-name="P65" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.2cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T25">잠자다 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr27" draw:text-style-name="P30" draw:layer="layout" svg:x1="1.2cm" svg:y1="10.9cm" svg:x2="9.5cm" svg:y2="10.9cm">
