   <draw:page draw:name="page148" draw:style-name="dp3" draw:master-page-name="기본값">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame draw:style-name="gr39" draw:text-style-name="P47" draw:layer="layout" svg:width="4.6cm" svg:height="1.395cm" svg:x="3cm" svg:y="13.5cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T1">친구들과 파티에 갈거다</text:span><text:span text:style-name="T1">. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr43" draw:text-style-name="P56" draw:layer="layout" svg:width="3cm" svg:height="1.953cm" svg:x="3.6cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T26">~</text:span><text:span text:style-name="T26">와 함께 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="11.4cm" svg:x2="9.5cm" svg:y2="11.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="2.4cm" svg:x2="9.5cm" svg:y2="2.4cm">
     <text:p/>
    </draw:line>
    <draw:line draw:style-name="gr22" draw:text-style-name="P29" draw:layer="layout" svg:x1="1.2cm" svg:y1="8.5cm" svg:x2="9.5cm" svg:y2="8.5cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr24" draw:text-style-name="P32" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T18">[wɪð, wɪθ]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr40" draw:text-style-name="P30" draw:layer="layout" svg:width="2.17cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">WITH</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P58" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T27">With shows being together or having something. For example, &apos;I went to the park with my friend&apos; means your friend was there too. It also shows what tool you use, like &apos;cut with a knife&apos;. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr29" draw:text-style-name="P53" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.5cm" svg:y="11.501cm">
     <draw:text-box>
      <text:p text:style-name="P52"><text:span text:style-name="T20">I am going to the party with my friends. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr44" draw:text-style-name="P59" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T28">(</text:span><text:span text:style-name="T28">영영사전</text:span><text:span text:style-name="T28">) </text:span><text:span text:style-name="T28">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
