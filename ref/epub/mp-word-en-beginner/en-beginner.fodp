    <draw:frame draw:style-name="gr100" draw:text-style-name="P65" draw:layer="layout" svg:width="10.5cm" svg:height="1.102cm" svg:x="0cm" svg:y="9.747cm">
     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T25">~</text:span><text:span text:style-name="T25">위에</text:span><text:span text:style-name="T25">, ~</text:span><text:span text:style-name="T25">에 </text:span></text:p>
