     <draw:text-box>
      <text:p text:style-name="P35"><text:span text:style-name="T25">그 </text:span><text:span text:style-name="T25">/ </text:span><text:span text:style-name="T25">그 남자 </text:span></text:p>
     </draw:text-box>
