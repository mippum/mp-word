     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">Here means in this place. It shows that something is close to the speaker. Example: &apos;Come here, please.&apos; People use it to point to a location or presence. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
