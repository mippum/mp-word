    <draw:frame draw:style-name="gr24" draw:text-style-name="P29" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T18">[ænd, ən(d)]</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr43" draw:text-style-name="P28" draw:layer="layout" svg:width="2.019cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">AND</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr44" draw:text-style-name="P45" draw:layer="layout" svg:width="9.915cm" svg:height="4.445cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P44"><text:span text:style-name="T24">And is a word used to join two or more ideas together. For example, &apos;I like apples and bananas&apos; means you like both. It makes sentences longer and connects thoughts smoothly.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P30" draw:layer="layout" svg:width="10.5cm" svg:height="1.191cm" svg:x="0cm" svg:y="11.901cm">
     <draw:text-box>
      <text:p text:style-name="P15"><text:span text:style-name="T19">I have a pen and a book.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr39" draw:text-style-name="P47" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T25">(</text:span><text:span text:style-name="T25">영영사전</text:span><text:span text:style-name="T25">) </text:span><text:span text:style-name="T25">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
