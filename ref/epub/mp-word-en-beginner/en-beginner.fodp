    </draw:frame>
    <draw:frame draw:style-name="gr69" draw:text-style-name="P74" draw:layer="layout" svg:width="3cm" svg:height="1.102cm" svg:x="3.6cm" svg:y="9.2cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T25">하나</text:span><text:span text:style-name="T25">, 1 </text:span></text:p>
     </draw:text-box>
    </draw:frame>
