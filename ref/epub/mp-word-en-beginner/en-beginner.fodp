     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr25" draw:text-style-name="P33" draw:layer="layout" svg:width="4.5cm" svg:height="0.772cm" svg:x="3.9cm" svg:y="1.3cm">
     <draw:text-box>
      <text:p text:style-name="P32"><text:span text:style-name="T18">[sʌn] </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr119" draw:text-style-name="P31" draw:layer="layout" svg:width="1.849cm" svg:height="1.191cm" svg:x="4.23cm" svg:y="0.31cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T17">SUN</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P67" draw:layer="layout" svg:width="9.915cm" svg:height="4cm" svg:x="0.385cm" svg:y="3.7cm">
     <draw:text-box>
      <text:p text:style-name="P57"><text:span text:style-name="T26">The sun is a big star that gives light and heat to Earth. It rises in the morning and sets in the evening. For example, &apos;The sun is bright today.&apos; </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr34" draw:text-style-name="P61" draw:layer="layout" svg:width="10.5cm" svg:height="2.131cm" svg:x="0.2cm" svg:y="11.601cm">
     <draw:text-box>
      <text:p text:style-name="P60"><text:span text:style-name="T20">The sun is shining brightly today. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr71" draw:text-style-name="P68" draw:layer="layout" svg:width="3cm" svg:height="0.653cm" svg:x="0cm" svg:y="2.947cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T27">(</text:span><text:span text:style-name="T27">영영사전</text:span><text:span text:style-name="T27">) </text:span><text:span text:style-name="T27">뜻</text:span></text:p>
     </draw:text-box>
    </draw:frame>
