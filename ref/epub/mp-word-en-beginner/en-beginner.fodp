    <draw:frame draw:style-name="gr43" draw:text-style-name="P56" draw:layer="layout" svg:width="3cm" svg:height="1.953cm" svg:x="3.6cm" svg:y="9.4cm">
     <draw:text-box>
      <text:p text:style-name="P31"><text:span text:style-name="T26">~</text:span><text:span text:style-name="T26">위에</text:span><text:span text:style-name="T26">, ~</text:span><text:span text:style-name="T26">에 </text:span></text:p>
